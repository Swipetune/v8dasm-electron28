# V8 12.8.374 Base Image - Built ONCE, reused for all v8dasm builds
# This contains the compiled v8_monolith (takes 2.5 hours)
# Push to ghcr.io and use in Dockerfile.fast

FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV NINJA_JOBS=8

# Install dependencies
RUN apt-get update && apt-get install -y \
    git curl python3 python3-pip pkg-config \
    build-essential clang lld ninja-build \
    libglib2.0-dev libatomic1 ccache \
    && rm -rf /var/lib/apt/lists/*

# Install depot_tools
RUN git clone --depth 1 https://chromium.googlesource.com/chromium/tools/depot_tools.git /opt/depot_tools
ENV PATH="/opt/depot_tools:${PATH}"

WORKDIR /v8-build

# Clone V8 12.8.374
RUN git clone --depth 1 --branch 12.8.374 https://chromium.googlesource.com/v8/v8.git .

# Create .gclient and sync
RUN echo 'solutions = [{"name": ".", "url": "https://chromium.googlesource.com/v8/v8.git@12.8.374", "deps_file": "DEPS", "managed": False}]' > .gclient
RUN gclient sync --shallow --no-history -D

# Configure build
RUN mkdir -p out.gn/x64.release && \
    printf '%s\n' \
    'dcheck_always_on = false' \
    'is_component_build = false' \
    'is_debug = false' \
    'target_cpu = "x64"' \
    'use_custom_libcxx = false' \
    'v8_monolithic = true' \
    'v8_use_external_startup_data = false' \
    'v8_static_library = true' \
    'v8_enable_disassembler = true' \
    'v8_enable_object_print = true' \
    'v8_enable_pointer_compression = true' \
    'v8_enable_sandbox = true' \
    'use_sysroot = false' \
    'treat_warnings_as_errors = false' \
    > out.gn/x64.release/args.gn

# Generate build files
RUN gn gen out.gn/x64.release

# Build V8 monolith (THE HEAVY PART - 2+ hours)
RUN ninja -j${NINJA_JOBS} -C out.gn/x64.release v8_monolith

# Mark as ready
RUN echo "V8 12.8.374 base image ready" > /v8-build/BUILD_COMPLETE
